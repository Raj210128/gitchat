# ─────────────────────────────────────────────────────────────────────────────
# GitHub Repository Chat Assistant – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
PROJECT_NAME="GitHub Chat Assistant"
ENV=development                 # development | staging | production
DEBUG=true
API_PREFIX=/api/v1

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...            # PAT – increases API rate limit (optional)
GITHUB_CLONE_DEPTH=1            # Shallow clone depth

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                 # Leave empty for local OSS Qdrant
QDRANT_COLLECTION_NAME=github_code_chunks

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.92   # Cosine similarity to return cached response

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512                  # Max tokens per chunk
CHUNK_OVERLAP=64                # Token overlap between consecutive chunks
MAX_CHUNKS_PER_FILE=200         # Guard-rail for very large files

# ── Retrieval ────────────────────────────────────────────────────────────────
TOP_K=8                         # Number of chunks retrieved per query
DENSE_WEIGHT=0.6                # RRF weight for dense (Qdrant) retriever
SPARSE_WEIGHT=0.4               # RRF weight for sparse (BM25) retriever
SCORE_THRESHOLD=0.35            # Minimum cosine score to include a chunk

# ── Storage ───────────────────────────────────────────────────────────────────
REPO_CLONE_DIR=/tmp/repo_clones

# ── Frontend (Next.js public vars) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
